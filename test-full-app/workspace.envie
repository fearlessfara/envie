version: '1.0'

project:
  name: full-demo
  description: Full demo application for testing complete deployment

environments:
  ephemeral:
    naming_pattern: "{project}-{id}"
    backend:
      type: s3
      config:
        bucket: "full-demo-terraform-state-20250108"
        region: "us-east-1"
        key_pattern: "ephemeral/{workspace}/{path}/terraform.tfstate"
        dynamodb_table: "full-demo-terraform-locks"
        encrypt: "true"
  
  stable: {}

defaults: {}